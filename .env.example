# Copy to .env.local — NEVER commit real secrets to git.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# SESSION_SECRET=put-a-long-random-string-here
# CRON_SECRET=put-a-long-random-string-here
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# FX: no key needed. /api/rates + /api/refresh use the keyless
# open.er-api.com/v6/latest/USD endpoint (daily refresh, cached
# 1 hour). Attribution "Rates By Exchange Rate API" is kept in
# every live FX source string on the site.
